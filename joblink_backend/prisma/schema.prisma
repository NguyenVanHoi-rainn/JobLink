generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique @db.VarChar(255)
  passwordHash         String?              @map("password_hash") @db.VarChar(255)
  role                 UserRole
  status               UserStatus           @default(ACTIVE)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  googleId             String?              @unique @map("google_id") @db.VarChar(255)
  conversationMembers  ConversationMember[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  employerProfile      EmployerProfile?
  messages             Message[]
  notifications        Notification[]
  pushTokens           PushToken[]
  reports              Report[]
  workerProfile        WorkerProfile?

  @@map("users")
}

model WorkerProfile {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @map("user_id") @db.Uuid
  fullName            String?              @map("full_name") @db.VarChar(150)
  phone               String?              @db.VarChar(20)
  bio                 String?
  searchArea          String?              @map("search_area") @db.VarChar(255)
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  maxDistanceKm       Int?                 @map("max_distance_km")
  preferredMinSalary  Decimal?             @map("preferred_min_salary") @db.Decimal(15, 2)
  preferredSalaryType SalaryType?          @map("preferred_salary_type")
  applications        Application[]
  cvs                 CV[]
  recommendations     JobRecommendation[]
  savedJobs           SavedJob[]
  workExperiences     WorkExperience[]
  availabilities      WorkerAvailability[]
  workerCategories    WorkerCategory[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerSkills        WorkerSkill[]

  @@map("worker_profiles")
}

model EmployerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  companyName        String             @map("company_name") @db.VarChar(255)
  description        String?
  address            String?            @db.VarChar(255)
  logoUrl            String?            @map("logo_url")
  businessLicense    String?            @map("business_license") @db.VarChar(255)
  taxCode            String?            @map("tax_code") @db.VarChar(100)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  contactName        String?            @map("contact_name") @db.VarChar(150)
  phone              String?            @db.VarChar(20)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs               Job[]

  @@map("employer_profiles")
}

model CV {
  id           String        @id @default(uuid()) @db.Uuid
  workerId     String        @map("worker_id") @db.Uuid
  fileName     String        @map("file_name") @db.VarChar(255)
  fileUrl      String        @map("file_url")
  uploadedAt   DateTime      @default(now()) @map("uploaded_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  applications Application[]
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("cvs")
}

model WorkExperience {
  id          String        @id @default(uuid()) @db.Uuid
  workerId    String        @map("worker_id") @db.Uuid
  companyName String        @map("company_name") @db.VarChar(255)
  position    String        @db.VarChar(255)
  description String?
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  isCurrent   Boolean       @default(false) @map("is_current")
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("work_experiences")
}

model WorkerAvailability {
  id        String        @id @default(uuid()) @db.Uuid
  workerId  String        @map("worker_id") @db.Uuid
  dayOfWeek DayOfWeek     @map("day_of_week")
  startTime DateTime      @map("start_time") @db.Time(6)
  endTime   DateTime      @map("end_time") @db.Time(6)
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_availabilities")
}

model Skill {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique @db.VarChar(150)
  status       Boolean       @default(true)
  jobSkills    JobSkill[]
  workerSkills WorkerSkill[]

  @@map("skills")
}

model WorkerSkill {
  workerId String        @map("worker_id") @db.Uuid
  skillId  String        @map("skill_id") @db.Uuid
  skill    Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, skillId])
  @@map("worker_skills")
}

model Category {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @unique @db.VarChar(150)
  status           Boolean          @default(true)
  jobs             Job[]
  workerCategories WorkerCategory[]

  @@map("categories")
}

model WorkerCategory {
  workerId   String        @map("worker_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
  @@map("worker_categories")
}

model Job {
  id              String              @id @default(uuid()) @db.Uuid
  employerId      String              @map("employer_id") @db.Uuid
  categoryId      String              @map("category_id") @db.Uuid
  title           String              @db.VarChar(255)
  description     String
  salary          Decimal?            @db.Decimal(15, 2)
  location        String              @db.VarChar(255)
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  cvRequired      Boolean             @default(false) @map("cv_required")
  deadline        DateTime?
  status          JobStatus           @default(DRAFT)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  endTime         DateTime?           @map("end_time") @db.Time(6)
  salaryType      SalaryType          @default(HOURLY) @map("salary_type")
  shiftType       ShiftType           @default(FLEXIBLE) @map("shift_type")
  startTime       DateTime?           @map("start_time") @db.Time(6)
  urgent          Boolean             @default(false)
  urgentUntil     DateTime?           @map("urgent_until")
  workDays        DayOfWeek[]         @default([]) @map("work_days")
  applications    Application[]
  conversations   Conversation[]
  recommendations JobRecommendation[]
  jobSkills       JobSkill[]
  category        Category            @relation(fields: [categoryId], references: [id])
  employer        EmployerProfile     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  savedJobs       SavedJob[]

  @@index([employerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([salaryType])
  @@index([shiftType])
  @@index([urgent])
  @@map("jobs")
}

model JobSkill {
  jobId   String @map("job_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  jobId           String            @map("job_id") @db.Uuid
  workerId        String            @map("worker_id") @db.Uuid
  cvId            String?           @map("cv_id") @db.Uuid
  status          ApplicationStatus @default(APPLIED)
  note            String?
  appliedAt       DateTime          @default(now()) @map("applied_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  cv              CV?               @relation(fields: [cvId], references: [id])
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker          WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  candidateMatch  CandidateMatch?
  workAppointment WorkAppointment?

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([status])
  @@map("applications")
}

model JobRecommendation {
  id        String        @id @default(uuid()) @db.Uuid
  workerId  String        @map("worker_id") @db.Uuid
  jobId     String        @map("job_id") @db.Uuid
  score     Decimal       @db.Decimal(5, 2)
  reasons   String?
  createdAt DateTime      @default(now()) @map("created_at")
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, jobId])
  @@index([workerId])
  @@index([jobId])
  @@index([score])
  @@map("job_recommendations")
}

model CandidateMatch {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @unique @map("application_id") @db.Uuid
  matchingScore Decimal     @map("matching_score") @db.Decimal(5, 2)
  reasons       String?
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("candidate_matches")
}

model Conversation {
  id        String               @id @default(uuid()) @db.Uuid
  jobId     String?              @map("job_id") @db.Uuid
  createdBy String               @map("created_by") @db.Uuid
  type      ConversationType
  name      String?              @db.VarChar(255)
  createdAt DateTime             @default(now()) @map("created_at")
  members   ConversationMember[]
  creator   User                 @relation("ConversationCreator", fields: [createdBy], references: [id])
  job       Job?                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([jobId])
  @@index([createdBy])
  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  conversationId String                 @map("conversation_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  memberRole     ConversationMemberRole @default(MEMBER) @map("member_role")
  joinedAt       DateTime               @default(now()) @map("joined_at")
  lastReadAt     DateTime               @default(now()) @map("last_read_at")
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  replyToId      String?      @map("reply_to_id") @db.Uuid
  content        String?
  messageType    MessageType  @default(TEXT) @map("message_type")
  fileUrl        String?      @map("file_url")
  sentAt         DateTime     @default(now()) @map("sent_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
  @@index([conversationId, sentAt])
  @@map("messages")
}

model WorkAppointment {
  id              String            @id @default(uuid()) @db.Uuid
  applicationId   String            @unique @map("application_id") @db.Uuid
  appointmentDate DateTime          @map("appointment_date")
  location        String            @db.VarChar(255)
  instruction     String?
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([appointmentDate])
  @@map("work_appointments")
}

model SavedJob {
  workerId String        @map("worker_id") @db.Uuid
  jobId    String        @map("job_id") @db.Uuid
  savedAt  DateTime      @default(now()) @map("saved_at")
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, jobId])
  @@map("saved_jobs")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String   @db.VarChar(255)
  content       String
  type          String   @db.VarChar(100)
  referenceType String?  @map("reference_type") @db.VarChar(100)
  referenceId   String?  @map("reference_id") @db.Uuid
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  reporterId  String       @map("reporter_id") @db.Uuid
  targetType  String       @map("target_type") @db.VarChar(100)
  targetId    String       @map("target_id") @db.Uuid
  reason      String       @db.VarChar(255)
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")
  resolvedAt  DateTime?    @map("resolved_at")
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(512)
  platform  String   @default("android") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

enum UserRole {
  WORKER
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  HIDDEN
}

enum SalaryType {
  HOURLY
  DAILY
  SHIFT
  MONTHLY
  FIXED
}

enum ShiftType {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  FLEXIBLE
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConversationType {
  PRIVATE
  APPLICANT_GROUP
  SELECTED_GROUP
}

enum ConversationMemberRole {
  MEMBER
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
